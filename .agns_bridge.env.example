# Agnes + Harness^2 bridge config. Copy to .agns_bridge.env and fill in.
# The one-click runner (agns-desktop.bat / run_agns_paths.sh|ps1) loads .agns_bridge.env.

# ---------- Path B (B3): real Agnes headless CLI, preferred when set ----------
# The CLI is executed with cwd = a workspace containing the staged harness +
# ledger.csv; env vars AGNES_TASK (task id) and AGNES_WORKSPACE are set.
# It may write answer.txt in the workspace, or print the answer to stdout.
# Leave empty to fall back to the bundled deterministic worker.
AGNES_CLI=

# ---------- Path A (A1): Agnes OpenAI-compatible model endpoint ----------
AGNES_API_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
AGNES_MODEL=agnes

# Bridge bind
AGNES_PROXY_HOST=127.0.0.1
AGNES_PROXY_PORT=8620

# ---- When you start the bridge, also set these in harness2/.env: ----------
# OpenCode executor (default):
#   HARNESS2_SOLVER_MODEL=openai/agnes
#   OPENAI_BASE_URL=http://127.0.0.1:8620/v1
#   OPENAI_API_KEY=agnes-bridge
# Codex executor (harness2 --substrate cx):
#   HARNESS2_CODEX_BASE_URL=http://127.0.0.1:8620/v1
#   HARNESS2_CODEX_API_KEY=agnes-bridge
